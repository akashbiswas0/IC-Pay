# Copy to repository .env, or run commands from apps/api with a local .env.
DATABASE_URL=postgresql://localhost:5432/suica_payments
CARD_HMAC_SECRET=
PORT=3001
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173
SESSION_HOURS=24
# All blockchain fields must refer to the SAME real testnet.
CHAIN_ID=
TOKEN_ADDRESS=
TOKEN_SYMBOL=MJPY
TOKEN_DECIMALS=18
PAYMENT_ADDRESS=
REWARD_PAYMENT_ADDRESS=
# Separate RewardPayments deployment on Sepolia; leave blank until deployed and linked.
REWARD_PAYMENT_CONTRACT=rewardpayments
TOKEN_CONTRACT=matsuristablecoin
PAYMENT_CONTRACT=demopayments
EXPLORER_URL=
MULTIBAAS_URL=
MULTIBAAS_API_KEY=
# Optional previous deployment for read-only funding Event Queries.
MULTIBAAS_HISTORY_URL=
MULTIBAAS_HISTORY_API_KEY=
# HTTPS JSON-RPC endpoint on CHAIN_ID for balance display during MultiBaas 429 errors.
BALANCE_RPC_URL=
# Confirmed reward getters use a separate read-only adapter with matching block hashes.
# EIP-1898 is required. When the URL is blank, this adapter uses BALANCE_RPC_URL.
REWARD_READ_MODE=rpc
REWARD_READ_RPC_URL=
CONFIRMATIONS=3
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_SIGNING_KEY=
WORLD_ENVIRONMENT=staging
MULTIBAAS_WEBHOOK_SECRET=
# Only needed for WORLD_ENVIRONMENT=staging; issued by Portal for a 24h window.
WORLD_STAGING_VERIFICATION_TOKEN=
AWS_REGION=
AWS_KMS_OPERATOR_KEY_ID=
# AWS credentials come from the standard SDK chain (profile/SSO/role); do not copy them here.

# Optional contract deployment (same network as MultiBaas)
TESTNET_CHAIN_ID=
TESTNET_RPC_URL=
CONTRACT_ADMIN_ADDRESS=
