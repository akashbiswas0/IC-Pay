# Copy to repository .env, or run commands from apps/api with a local .env.
DATABASE_URL=postgresql://localhost:5432/suica_payments
CARD_HMAC_SECRET=
PORT=3001
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173
SESSION_HOURS=24
# All blockchain fields must refer to the SAME real testnet.
CHAIN_ID=
TOKEN_ADDRESS=
TOKEN_SYMBOL=icUSD
TOKEN_NAME=IC Stablecoin
# Display alias only; the deployed immutable token still identifies itself as MJPY.
TOKEN_ONCHAIN_SYMBOL=MJPY
TOKEN_DECIMALS=18
PAYMENT_ADDRESS=
TOKEN_CONTRACT=matsuristablecoin
PAYMENT_CONTRACT=demopayments
EXPLORER_URL=
MULTIBAAS_URL=
MULTIBAAS_API_KEY=
CONFIRMATIONS=3
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_SIGNING_KEY=
WORLD_ENVIRONMENT=staging
MULTIBAAS_WEBHOOK_SECRET=
# Only needed for WORLD_ENVIRONMENT=staging; issued by Portal for a 24h window.
WORLD_STAGING_VERIFICATION_TOKEN=
AWS_REGION=
AWS_KMS_OPERATOR_KEY_ID=
# AWS credentials come from the standard SDK chain (profile/SSO/role); do not copy them here.
# Optional additional router; keep legacy PAYMENT_ADDRESS/CONTRACT unchanged for old receipts/jobs.
REWARD_PAYMENT_ADDRESS=
REWARD_PAYMENT_CONTRACT=rewardpayments
# Optional prior deployment for read-only funding Event Queries; never signs or submits.
MULTIBAAS_HISTORY_URL=
MULTIBAAS_HISTORY_API_KEY=
# Confirmed reward-state getters only. Free MultiBaas plans may lack historical eth_call.
REWARD_READ_MODE=rpc
REWARD_READ_RPC_URL=
# When omitted, reward read RPC uses BALANCE_RPC_URL; EIP-1898 support is mandatory.

# Once per verified customer account, fixed 1000 test icUSD display units; Sepolia only.
TEST_FUNDING_ENABLED=false
TEST_FUNDING_DAILY_LIMIT=100

# Separate retained-NFT credit router. Keep previous routers configured for history/jobs.
COLLECTIBLE_PAYMENT_ADDRESS=
COLLECTIBLE_PAYMENT_CONTRACT=collectiblerewards
COLLECTIBLE_ARTWORK_BASE_URL=

# Pooled per-card-wallet, per-merchant loyalty points; keep all earlier router settings.
LOYALTY_PAYMENT_ADDRESS=
LOYALTY_PAYMENT_CONTRACT=loyaltypoints
